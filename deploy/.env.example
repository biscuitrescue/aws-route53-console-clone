# Settings for docker-compose.prod.yml. deploy/gcp/deploy.sh generates the real .env on the VM.

# Public host name Caddy serves and requests a certificate for.
SITE_ADDRESS=203-0-113-10.sslip.io

# Artifact Registry path that holds the frontend and backend images, and the tag to run.
IMAGE_PREFIX=us-central1-docker.pkg.dev/my-project/route53-clone
IMAGE_TAG=latest

# Demo account shown on the sign-in page of the hosted demo.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me

# Host directory that holds the SQLite database.
DATA_DIR=/srv/route53/data
