# Copy to .env for local development. Every variable is optional; these are the defaults.

# development | test | production
R53_ENVIRONMENT=development

# SQLite file. Relative paths resolve from the backend/ directory.
R53_DATABASE_URL=sqlite:///./data/route53.db

# Session cookie. Set R53_COOKIE_SECURE=true whenever the site is served over HTTPS.
R53_SESSION_COOKIE_NAME=r53_session
R53_SESSION_TTL_HOURS=336
R53_COOKIE_SECURE=false

# Failed sign-ins allowed within the window, per client address and account, and per
# client address across all accounts. 0 turns a limit off.
R53_LOGIN_MAX_FAILURES=5
R53_LOGIN_MAX_FAILURES_PER_CLIENT=20
R53_LOGIN_FAILURE_WINDOW_SECONDS=300

# Other origins allowed to send state-changing requests, as a JSON list. Leave empty when
# the frontend proxies the API, which is how this project runs everywhere.
R53_TRUSTED_ORIGINS=[]

# Demo account created by `python -m app.seed`. Change the password for a public deployment.
R53_DEMO_EMAIL=demo@example.com
R53_DEMO_PASSWORD=Route53Demo!
R53_DEMO_DISPLAY_NAME=demo-admin
R53_DEMO_ACCOUNT_ID=111122223333

# Show the sign-in credentials on the sign-in page (GET /api/v1/auth/published-credentials).
R53_DEMO_CREDENTIALS_PUBLIC=true

# Create the sample hosted zones when they do not exist yet.
R53_SEED_DEMO_DATA=true

# Give every visitor who signs in to the demo account a private copy of the sample zones
# (a sandbox), remembered by a cookie. Off: everyone shares the demo account's zones.
R53_DEMO_SANDBOX=true
R53_SANDBOX_COOKIE_NAME=r53_sandbox
# A sandbox unused for this many days is deleted; so is the stalest beyond the maximum.
R53_SANDBOX_IDLE_DAYS=14
R53_SANDBOX_MAX=500
# New sandboxes one client address may start per hour. 0 turns the limit off.
R53_SANDBOX_CREATIONS_PER_HOUR=60

# Seconds a record change reports PENDING before INSYNC. The status is simulated: the
# change is saved at once and nothing is propagated.
R53_CHANGE_PROPAGATION_SECONDS=10

# Quotas per account and per hosted zone; the defaults are Route 53's own. 0 turns one off.
R53_MAX_HOSTED_ZONES=500
R53_MAX_RECORDS_PER_ZONE=10000
