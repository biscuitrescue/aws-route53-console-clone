{
  "name": "route53-clone-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "cd ../backend && uv run python -m app.export_openapi > ../frontend/lib/api/openapi.json && cd ../frontend && openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@cloudscape-design/collection-hooks": "^1.0.110",
    "@cloudscape-design/components": "^3.0.1396",
    "@cloudscape-design/design-tokens": "^3.0.114",
    "@cloudscape-design/global-styles": "^1.0.71",
    "@tanstack/react-query": "^5.104.1",
    "next": "16.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
