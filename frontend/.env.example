# Copy to .env.local for local development.

# Base URL of the FastAPI backend. /api/* is proxied to it by Next.js (see next.config.ts).
# The proxy reads it when the app is built or the dev server starts; the sign-in page,
# which asks the backend for the published credentials, reads it when the server runs.
BACKEND_URL=http://127.0.0.1:8000
